# Absolute path to an Obsidian-style Vault.
# When omitted, the app uses ../个人知识库.
PERSONAL_DASHBOARD_VAULT_ROOT=/absolute/path/to/your-vault

# Optional. Keep the development server loopback-only unless you add auth.
# PERSONAL_DASHBOARD_HOST=127.0.0.1

# Outlook / Microsoft Graph (multi-tenant, delegated Mail.Read).
# Register this exact redirect URI in Microsoft Entra before connecting. The app
# must allow accounts in any organizational directory; users sign in on Microsoft.
WORKBENCH_PORT=5174
# Optional: omit to use Microsoft’s `common` endpoint for one-click sign-in.
# OUTLOOK_ENTRA_TENANT_ID=your-tenant-id
OUTLOOK_ENTRA_CLIENT_ID=your-public-client-id
OUTLOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:5174/api/outlook/oauth/callback
# Generate a 32-byte Base64 value; it encrypts local Outlook state and tokens.
OUTLOOK_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# DingTalk calendar (read-only, internal app user authorization)
DINGTALK_CLIENT_ID=your-dingtalk-app-key
DINGTALK_CLIENT_SECRET=your-dingtalk-app-secret
# Optional HTTPS proxy for networks that block direct access to DingTalk.
# DINGTALK_HTTPS_PROXY=http://127.0.0.1:7890
DINGTALK_OAUTH_REDIRECT_URI=http://127.0.0.1:5174/api/dingtalk/oauth/callback
# Optional: reuse OUTLOOK_TOKEN_ENCRYPTION_KEY when both integrations are local.
DINGTALK_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# DINGTALK_USER_ID=me
# DINGTALK_CALENDAR_ID=primary

# Email bodies are sent to DeepSeek for classification and are never stored locally.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Team daily reports (Electron and Web adapters)
# Local development defaults to http://127.0.0.1:8787; set this only for a remote team service.
# VITE_TEAM_REPORT_API_URL=https://reports.example.com
TEAM_REPORT_ALLOWED_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
TEAM_REPORT_PORT=8787
TEAM_REPORT_UI_URL=http://127.0.0.1:5174
# Comma-separated DingTalk user IDs that should be administrators.
TEAM_REPORT_ADMIN_DINGTALK_IDS=
# Team-report OAuth callback registered in the DingTalk app.
DINGTALK_TEAM_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/team/auth/dingtalk/callback
DINGTALK_TEAM_OAUTH_SCOPES=openid
# If the current network blocks direct DingTalk HTTPS access, set a local proxy.
# DINGTALK_HTTPS_PROXY=http://127.0.0.1:7890
# Direct access requires api.dingtalk.com:443 and oapi.dingtalk.com:443.
MYSQL_URL=mysql://root:root@localhost:3306/workbench_reports
