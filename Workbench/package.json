{
  "name": "personal-ai-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && electron electron/main.mjs\"",
    "electron:build": "vite build && electron-builder",
    "test": "npm run build && node scripts/test.mjs",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "demo:generate": "node scripts/generate-demo-douyin.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test:authenticity": "node --test tests/data-authenticity.test.mjs",
    "test:ui-information-gate": "node --test tests/ui-information-gate.test.mjs",
    "test:daily-hot": "node --test tests/daily-hot.test.mjs",
    "test:social-insights": "node --test tests/social-insights.test.mjs tests/social-insights-ui.test.mjs",
    "test:materials": "node --test tests/materials.test.mjs tests/material-reading-state.test.mjs",
    "test:books": "node --test tests/books.test.mjs tests/book-reading-progress.test.mjs",
    "test:vault-sync": "node --test tests/vault-sync.test.mjs",
    "test:graph-motion": "node --test tests/graph-v6-motion.test.mjs tests/graph-v6-model.test.mjs",
    "test:reader-anchors": "node --test tests/reader-anchors.test.mjs",
    "test:reader-ui": "node --test tests/reader-ui.test.mjs",
    "test:reader-api": "node --test tests/reader-api.test.mjs",
    "test:reader-explanations": "node --test tests/reader-explanations.test.mjs",
    "test:reader-notes": "node --test tests/reader-notes.test.mjs",
    "test:wiki-ingest": "node --test tests/wiki-ingest-runner.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tabler/icons-react": "^3.34.1",
    "@vitejs/plugin-react": "5.0.4",
    "better-sqlite3": "^11.10.0",
    "concurrently": "^9.2.1",
    "d3-force": "^3.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^2.15.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vite": "6.4.2",
    "wait-on": "^8.0.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.personalai.workbench",
    "productName": "Personal AI Workbench",
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "src/data/**/*",
      "config/**/*",
      "package.json"
    ],
    "asar":  true,
    "asarUnpack":  [
                       "node_modules/better-sqlite3/**/*"
                   ],
    "extraResources":  [
                           {
                               "from":  ".env",
                               "to":  ".env"
                           }
                       ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12"
  }
}
